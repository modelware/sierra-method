@dc:title "Component vocabulary"
@dc:description "Defines components."
vocabulary <https://www.modelware.io/sierra/component#> as component {
    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://www.w3.org/2000/01/rdf-schema#> as rdfs

    extends <https://www.modelware.io/sierra/base#> as base

	extends <http://opencaesar.io/isq/> as isq

    @rdfs:comment "A component is a part of a system."
    concept Component < base:Container, base:Contained, base:Element

    @rdfs:comment "A physical part of the system."
    concept PhysicalPart < Component

    @rdfs:comment "The mass of the physical part."
    quantity property mass [
        domain PhysicalPart
        quantity isq:Mass
        functional
    ]

    @rdfs:comment "The interface of a component."
    concept Port < base:Contained, base:Element

    @rdfs:comment "The port of a component."
    relation hasPort [
        from Component
        to Port
        reverse portOf
        inverse functional
    ]

    @rdfs:comment "Port Direction."
    scalar Direction [
        oneOf "In", "Out"
    ]

    @rdfs:comment "The direction of the port."
    scalar property direction [
        domain Port
        range Direction
        functional
    ]

    @rdfs:comment "Indicates that two ports are connected."
    relation entity Connection [
        from Port
        to Port
        forward connectedTo
    ] < base:Element

    concept Signal < base:Item

    concept Material < base:Item

    concept Energy < base:Item

    relation transfers [
        from Connection
        to base:Item
        reverse isTransferedBy
    ]

}
